{
    "name": "krayin/laravel-statamic-integration",
    "description": "Statamic CMS integration module for Krayin CRM",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "statamic/cms": "6.42.0",
        "inertiajs/inertia-laravel": "^2.0.7",
        "enshrined/svg-sanitize": "^1.0.0"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\StatamicIntegration\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webkul\\StatamicIntegration\\Providers\\StatamicIntegrationServiceProvider"
            ]
        }
    }
}
